# Copy this file to .streamlit/secrets.toml and fill in the real values.
# .streamlit/secrets.toml is gitignored — never commit it.
#
# client_id / client_secret come from a Google Cloud OAuth client
# (see README, "Etapa Cloud A — Login con Google").
#
# cookie_secret: any long random string, used to sign the session cookie.
# Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# redirect_uri: must exactly match one of the "Authorized redirect URIs"
# configured on the Google OAuth client. Use the localhost one while
# developing, the real domain one once deployed.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_RANDOM_SECRET"
client_id = "REPLACE_WITH_YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REPLACE_WITH_YOUR_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
