# ---------- IA (opcional al principio) ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ---------- Instagram ----------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ---------- AWS S3 (solo para publicar) ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=instagram-rebuild

# ---------- Modo prueba ----------
# true: el botón de publicar simula el resultado y NO llama a la API de
# Instagram ni sube nada a S3. Déjalo en true mientras pruebas la app.
DRY_RUN=true

# ---------- Acceso (login con Google) ----------
# Lista de correos separados por coma que pueden entrar a la app, aunque
# el login con Google sea exitoso. Vacío = cualquier cuenta de Google que
# inicie sesión entra (NO recomendado para una app pública).
ALLOWED_GOOGLE_EMAILS=
